{
  "name": "aegis",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.27.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:sdk:pack": "node scripts/verify-sdk-tarball.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:init": "bash scripts/init-replica-set.sh",
    "db:indexes": "pnpm --filter @aegis/api db:indexes",
    "db:seed": "pnpm --filter @aegis/api db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}
