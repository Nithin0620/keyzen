# Keyzen Web Dashboard — Environment Variables

# URL of your Keyzen API (Fastify or Cloudflare Worker)
NEXT_PUBLIC_API_URL=http://localhost:4000/graphql

# Workflow API base URL (used for shared authentication)
# In production: https://workflow.ssh.net.in
NEXT_PUBLIC_WORKFLOW_API_URL=http://localhost:3001

# The SAME value as NEXTAUTH_SECRET in your workflow project.
# Both apps must share this secret so Keyzen can verify JWT tokens
# issued by Workflow's /api/v1/auth/login endpoint.
WORKFLOW_AUTH_SECRET=your-nextauth-secret-here
