{
  "name": "@keyzen/api",
  "version": "0.1.0",
  "description": "Fastify Node.js & Cloudflare Worker Edge Secrets Engine for Keyzen",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsup src/server.ts --format esm --dts",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.mjs",
    "test": "vitest run",
    "worker:dev": "wrangler dev src/worker.ts",
    "worker:deploy": "wrangler deploy src/worker.ts",
    "clean": "rm -rf dist .wrangler"
  },
  "dependencies": {
    "@apollo/server": "^4.11.0",
    "@as-integrations/fastify": "^2.1.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^9.1.0",
    "@keyzen/crypto": "workspace:*",
    "@keyzen/db": "workspace:*",
    "@types/jsonwebtoken": "^9.0.10",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "graphql": "^16.9.0",
    "graphql-yoga": "^5.7.0",
    "hono": "^4.5.11",
    "jsonwebtoken": "^9.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240909.0",
    "@types/node": "^22.5.4",
    "tsup": "^8.2.4",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.1",
    "wrangler": "^3.75.0"
  }
}
