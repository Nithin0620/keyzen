{
  "name": "@keyzen/crypto",
  "version": "0.1.0",
  "description": "AES-256-GCM Envelope Encryption and Key Management for Keyzen",
  "license": "MIT",
  "author": "KS Nithin <nithin30302@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nithin0620/keyzen.git",
    "directory": "packages/crypto"
  },
  "homepage": "https://github.com/Nithin0620/keyzen/tree/master/packages/crypto#readme",
  "bugs": {
    "url": "https://github.com/Nithin0620/keyzen/issues"
  },
  "keywords": [
    "aes-256-gcm",
    "envelope-encryption",
    "hkdf",
    "key-derivation",
    "encryption"
  ],
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^22.5.4",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "vitest": "^2.1.1"
  }
}
