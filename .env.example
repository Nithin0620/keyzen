# Copy to .env and fill in real values. Never commit .env.

# --- Database ---
MONGODB_URI="mongodb://localhost:27017/aegis?replicaSet=rs0"

# --- Redis ---
REDIS_URL="redis://localhost:6379"

# --- API ---
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
AUTH_SECRET=replace-with-a-long-random-string
AUTH_ACCESS_TTL=900
AUTH_REFRESH_TTL=2592000

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# --- Encryption ---
# Dev only. In production use a KMS provider and set AEGIS_KMS_KEY_ID.
AEGIS_MASTER_KEY=replace-with-base64-of-32-random-bytes
AEGIS_KMS_KEY_ID=
AWS_REGION=us-east-1

# --- Email ---
RESEND_API_KEY=
EMAIL_FROM="Aegis <no-reply@example.com>"

# --- Billing ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=
