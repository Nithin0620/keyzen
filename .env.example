# Copy to .env and fill in real values. Never commit .env.

# --- Database ---
MONGODB_URI="mongodb://localhost:27017/aegis?replicaSet=rs0"

# --- Redis ---
REDIS_URL="redis://localhost:6379"

# --- API ---
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
AUTH_SECRET=replace-with-a-long-random-string
AUTH_ACCESS_TTL=900
AUTH_REFRESH_TTL=2592000
AUDIT_RETENTION_DAYS=365
SERVICE_TOKEN_RATE_LIMIT=60
SERVICE_TOKEN_RATE_WINDOW_MS=60000

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# --- Encryption ---
# Dev only. In production use a KMS provider and set AEGIS_KMS_KEY_ID.
AEGIS_MASTER_KEY=replace-with-base64-of-32-random-bytes
AEGIS_KMS_KEY_ID=
AWS_REGION=us-east-1

# --- Email ---
RESEND_API_KEY=
EMAIL_FROM="Aegis <no-reply@example.com>"

# --- Billing ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# --- Integrations and background work ---
WEBHOOK_SECRET_ENCRYPTION_KEY=replace-with-base64-of-32-random-bytes
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_TIMEOUT_MS=5000
OPS_ALERT_EMAIL=ops@example.com
JOB_TOKEN_CLEANUP_INTERVAL_MS=3600000
JOB_KEY_ROTATION_INTERVAL_MS=86400000
JOB_AUDIT_RETENTION_INTERVAL_MS=86400000
JOB_INVITATION_CLEANUP_INTERVAL_MS=3600000
JOB_WEBHOOK_RETRY_INTERVAL_MS=60000
JOB_KEY_ROTATION_TARGET_ID=

# --- Hardening and observability ---
LOG_LEVEL=info
WEB_ORIGINS=
REQUEST_BODY_LIMIT=1mb
MAX_URL_LENGTH=4096
TRUST_PROXY=0
ENFORCE_TLS=false
GLOBAL_RATE_LIMIT=300
GLOBAL_RATE_WINDOW_MS=60000

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:3001

ABUSE_ALERT_THRESHOLD=10
ABUSE_ALERT_WINDOW_MS=300000
OTEL_ENABLED=false
OTEL_SERVICE_NAME=aegis-api
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
